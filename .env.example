SECRET_KEY=replace-with-a-random-secret
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/studentvera
APP_NAME=STUDENTVERA AI
APP_ENV=development
DEMO_MODE=false
# Set these only for an isolated, fictional demo deployment with DEMO_MODE=true.
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_PASSWORD=
# Temporary one-time administrator setup only; remove these after running:
# flask --app run bootstrap-admin
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Existing administrator reset only; remove these after running:
# flask --app run reset-admin-password
ADMIN_RESET_USERNAME=
# Optional: omit to keep the current username.
ADMIN_RESET_NEW_USERNAME=
ADMIN_RESET_PASSWORD=
CONFIRM_ADMIN_PASSWORD_RESET=
# Local development: omit DATABASE_URL to use studentvera_dev.db, or use:
# DATABASE_URL=sqlite:///studentvera_dev.db
